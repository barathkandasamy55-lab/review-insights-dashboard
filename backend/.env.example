# Copy to .env  (never commit .env)
DATABASE_URL="postgresql://reviews:reviews@localhost:5433/reviews?schema=public"
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Scraper: browser channel to drive. "chrome" (recommended), "msedge", or empty for bundled Chromium.
SCRAPER_CHANNEL=chrome
# Politeness delay between page requests (ms)
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=3500
